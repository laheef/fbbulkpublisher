# LinkEasy Publisher — environment template
# Copy to .env (or export these variables) and fill in real values.
# NEVER commit real credentials.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://publisher.example.com
APP_KEY=generate-a-64-character-random-string

# Database: mysql (production) or sqlite (demo/testing)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linkeasy
DB_USERNAME=linkeasy
DB_PASSWORD=
# SQLite only
DB_SQLITE_PATH=

# Sessions
SESSION_SECURE=true

# Publishing provider: browser | simulated
PUBLISHING_PROVIDER=browser

# Media strategy: SERVER | LOCAL | EXTERNAL | HYBRID
MEDIA_STRATEGY=SERVER

# Optional server-side FFmpeg (the Windows app always ships its own build)
FFMPEG_BIN=
FFPROBE_BIN=

LOG_LEVEL=info

# Reserved: allows a future official Graph API provider. Not implemented in
# this build — see app/Services/Publishing/OfficialApiPublishingProvider.php
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
